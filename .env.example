SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://username:password@host:5432/database
# Canonical origin for emailed links and shared URLs. Use http://127.0.0.1:8080 locally.
PUBLIC_BASE_URL=https://templobooker.com
ADMIN_EMAILS=luke.david.reimer@gmail.com
PORT=8080
FLASK_DEBUG=0
# Set to 0 for local http development (session cookies require https when 1)
SESSION_COOKIE_SECURE=1
# MailerSend API key + From address are configured in Admin → Email at runtime.
